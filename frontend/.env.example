# Dev: leave as /api/v1 (Vite proxies to the backend on :5005). Production: same-origin behind nginx.
VITE_API_URL=/api/v1
# Show demo OTP hint on the auth screen (last 6 digits of mobile).
VITE_OTP_BYPASS_HINT=true
# Vendor panel: full UI with SOW dummy data (set false to use live API only).
VITE_VENDOR_DEMO=true

# Firebase Web Push (FCM) — values from Firebase console > Project settings
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Cloud Messaging > Web configuration > Web Push certificates key pair
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key
